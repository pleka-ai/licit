// licit.es (static site + Parquet) and api.licit.es (public API), one Worker.
{
  "name": "licit",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  // Run next to D1 (WEUR): API calls make several sequential queries.
  "placement": { "mode": "smart" },
  "assets": {
    "directory": "./site",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "licit-api",
      "database_id": "bd4f71e0-fa34-46af-b6da-ddcc2b1eca46",
      "migrations_dir": "worker"
    }
  ],
  "r2_buckets": [{ "binding": "DATA", "bucket_name": "licit-data" }],
  "routes": [
    { "pattern": "licit.es", "custom_domain": true },
    { "pattern": "www.licit.es", "custom_domain": true },
    { "pattern": "api.licit.es", "custom_domain": true }
  ]
}
